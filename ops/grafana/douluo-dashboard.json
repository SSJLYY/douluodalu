{
  "uid": "douluo-overview",
  "title": "斗罗大陆 · 放置传说 总览",
  "description": "后端 HTTP/业务/资源三行总览。数据源由 provisioning 自动注册（Prometheus），面板通过 ${DS_PROMETHEUS} 变量引用，可切换任意 Prometheus 数据源。",
  "tags": ["douluo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "数据源",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "QPS（HTTP 请求速率）",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"douluo-backend\"}[5m]))", "legendFormat": "QPS" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 错误率（5xx 占比）",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"douluo-backend\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"douluo-backend\"}[5m]))", "legendFormat": "5xx 占比" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "活跃 DB 连接（HikariCP）",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 6 }, { "color": "red", "value": 9 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active{job=\"douluo-backend\"}", "legendFormat": "活跃连接" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "战斗速率（按 outcome）",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(douluo_battle_total[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "签到 / 补签速率",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(douluo_checkin_total[5m]))", "legendFormat": "签到" },
        { "refId": "B", "expr": "sum(rate(douluo_checkin_makeup_total[5m]))", "legendFormat": "补签" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "觉醒 / 转生 / 流派选择速率",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (kind) (rate(douluo_awaken_total[5m]))", "legendFormat": "觉醒 {{kind}}" },
        { "refId": "B", "expr": "sum(rate(douluo_prestige_total[5m]))", "legendFormat": "转生" },
        { "refId": "C", "expr": "sum(rate(douluo_school_choose_total[5m]))", "legendFormat": "流派选择" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "任务领取速率（按 quest_id）",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (quest_id) (rate(douluo_quest_claim_total[5m]))", "legendFormat": "{{quest_id}}" },
        { "refId": "B", "expr": "sum(rate(douluo_quest_claim_total[5m]))", "legendFormat": "合计" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM 内存（按 area）",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (area) (jvm_memory_used_bytes{job=\"douluo-backend\"})", "legendFormat": "{{area}}" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GC 暂停（p99 与每秒耗时）",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(jvm_gc_pause_seconds_bucket{job=\"douluo-backend\"}[5m])))", "legendFormat": "GC p99" },
        { "refId": "B", "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"douluo-backend\"}[5m]))", "legendFormat": "每秒 GC 耗时" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU 使用率（进程 / 系统）",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.9 } ] },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage{job=\"douluo-backend\"}", "legendFormat": "进程" },
        { "refId": "B", "expr": "system_cpu_usage{job=\"douluo-backend\"}", "legendFormat": "系统" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HikariCP 连接池",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active{job=\"douluo-backend\"}", "legendFormat": "活跃" },
        { "refId": "B", "expr": "hikaricp_connections_idle{job=\"douluo-backend\"}", "legendFormat": "空闲" },
        { "refId": "C", "expr": "hikaricp_connections_pending{job=\"douluo-backend\"}", "legendFormat": "等待" },
        { "refId": "D", "expr": "hikaricp_connections_max{job=\"douluo-backend\"}", "legendFormat": "上限" }
      ]
    }
  ]
}
