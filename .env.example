# docker compose 用环境变量示例：复制为 .env 后填写（.env 勿提交）
# 生成强随机密钥：openssl rand -base64 48

# ---- 必填 ----
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me
# JWT 签名密钥，必须 ≥ 32 字节，否则后端启动即失败
JWT_SECRET=change-me-change-me-change-me-change-me-32bytes

# ---- 数据库（compose 内默认值，可与 backend 共用）----
DB_NAME=douluo_game
DB_USER=douluo

# ---- 访问地址 ----
# 前端可接受的跨域来源，逗号分隔；上线改为 https://your-domain.com
CORS_ORIGINS=http://localhost:3000
# 前端构建时内联的后端地址（改后必须重新 build 镜像）
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- 宿主机端口映射（可选）----
BACKEND_PORT=8080
FRONTEND_PORT=3000
